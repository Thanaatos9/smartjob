# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# n8n
N8N_OFFER_WEBHOOK_URL=https://n8n.samuelrilos.com/webhook/job-offer-app
N8N_OFFER_PDF_WEBHOOK_URL=https://n8n.samuelrilos.com/webhook/job-offer-pdf
N8N_GENERATE_LETTER_WEBHOOK_URL=https://n8n.samuelrilos.com/webhook/generate-letter
N8N_SEARCH_WEBHOOK_URL=https://n8n.samuelrilos.com/webhook/job-search
N8N_SCORE_WEBHOOK_URL=https://n8n.samuelrilos.com/webhook/score-offer
N8N_PORTFOLIO_WEBHOOK_URL=https://n8n.samuelrilos.com/webhook/portfolio-fetch
N8N_WEBHOOK_SECRET=change-me

# Resend
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=onboarding@resend.dev

# OpenAI (note de correspondance CV/offre)
OPENAI_API_KEY=sk-xxxxxxxxx

# Skill Claude « postuler » (routes /api/skill/*)
# Jeton long et aléatoire (openssl rand -hex 32) et id Supabase de ton compte.
SKILL_API_TOKEN=
SKILL_USER_ID=

# CV et lettre adaptés générés dans l'app (facultatif, défaut gpt-6.2-sol).
# gpt-6.2-astra rédige encore mieux, plus cher ; gpt-4o-mini pour revenir à l'ancien.
OPENAI_TAILOR_MODEL=

# Veille quotidienne : boîte dédiée aux alertes des plateformes (IMAP).
# Seuls les mails de LinkedIn, WTTJ, JobTeaser, Indeed, HelloWork et Business France
# sont lus ; ceux qui contiennent des offres sont rangés dans VEILLE_DONE_FOLDER.
VEILLE_IMAP_HOST=
VEILLE_IMAP_PORT=993
VEILLE_IMAP_SECURE=true
VEILLE_IMAP_USER=pro@samuelrilos.com
VEILLE_IMAP_PASSWORD=
VEILLE_IMAP_FOLDER=INBOX
VEILLE_DONE_FOLDER=Veille-traitees
